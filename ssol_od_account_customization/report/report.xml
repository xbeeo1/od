<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="paperformat_copper_invoice_report" model="report.paperformat">
            <field name="name">Cooper Invoice Report Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">20</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">40</field>
            <field name="dpi">90</field>
        </record>

        <record id="paperformat_bill_quot_report" model="report.paperformat">
            <field name="name">Bill Quotation Report Paper Format</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">80</field>
            <field name="margin_bottom">20</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">80</field>
            <field name="dpi">90</field>
        </record>


        <record id="action_copper_invoice_report" model="ir.actions.report">
            <field name="name">Custom Invoice Report</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ssol_od_account_customization.cooper_invoice_report_template</field>
            <field name="report_file">ssol_od_account_customization.cooper_invoice_report_template</field>
            <field name="paperformat_id" ref="paperformat_copper_invoice_report"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
        </record>

        <record id="action_copper_invoice_report_01" model="ir.actions.report">
            <field name="name">Custom Invoice Report Without Letterhead</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ssol_od_account_customization.copper_invoice_report_template_01</field>
            <field name="report_file">ssol_od_account_customization.copper_invoice_report_template_01</field>
            <field name="paperformat_id" ref="paperformat_copper_invoice_report"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">(object._get_report_base_filename())</field>
        </record>


        <record id="action_bill_quot_report" model="ir.actions.report">
            <field name="name">Bill Invoice Report</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ssol_od_account_customization.bill_quot_report_template</field>
            <field name="report_file">ssol_od_account_customization.bill_quot_report_template</field>
            <field name="paperformat_id" ref="ssol_od_account_customization.paperformat_bill_quot_report"/>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <!--        <field name="print_report_name">'('%s' % (object.name))'</field>-->
            <field name="print_report_name">'Bill Invoice Report'</field>
        </record>


    </data>
</odoo>