<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="mrp_report_template_2">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <style>
                        @font-face {
                        font-family: 'Roman';
                        src: url('/ssol_od_mrp_customization/static/src/fonts/times-new-roman.ttf')
                        format('truetype');
                        }
                        body {
                        font-family: 'Roman', serif;
                        }
                        .font-text {
                        font-family: 'Roman', sans-serif;
                        }
                    </style>

                    <div class="page font-text"
                         style="margin-left: 20px; border-left: 5px solid #f21d21; margin-right: 20px; font-size: 18px; padding-left: 10px;">
                        <t t-call="web.html_container">
                            <t t-set="company" t-value="res_company"/>
                            <t t-set="partner" t-value="res_partner"/>
                            <br/>
                            <br/>
                            <div class="row">
                                <table class="table table-borderless">
                                    <tr>
                                        <td>
                                            <img src="/ssol_od_mrp_customization/static/src/img/header_footer/new_head.png"
                                                 width="140px"
                                                 height="60px"
                                                 style="padding-left: 20px;"/>
                                        </td>
                                        <td style="vertical-align: middle; padding-left: 20px;">
                                            <span style="font-size: 30px; font-weight: bold; color: #c00000">
                                                OMERDRAZ ENGINEERING COMPANY
                                            </span>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            <div class="row" style="text-align: center; margin-top:-25px">
                                <span style="font-size: 24px; font-weight: bold; text-decoration: underline; display: block;">
                                    INSPECTION / TEST REPORT
                                </span>
                            </div>
                            <br/>


                            <!-- IF REF NO OR DATE-->
                            <t t-if="o.ref_noc or o.date_trc">
                                <div style="padding-left: 5px; width: 100%; margin-bottom: 5px;">
                                    <div style="width: 80%; float: left;">
                                        <span style="font-weight: bold">Ref No: </span>
                                        <span style="text-decoration: underline"><t t-esc="o.ref_noc"/></span>
                                    </div>
                                    <div style="width: 20%; float: right;">
                                        <span style="font-weight: bold">Date: </span>
                                        <span style="text-decoration: underline"><t t-esc="o.date_trc"/></span>
                                    </div>
                                </div>
                                <br/>
                            </t>

                            <!-- IF FOR M/s-->
                            <t t-if="o.for_m_sc">
                                <table class="table table-borderless">
                                    <tr>
                                        <td style="text-align: left; padding-bottom: 5px; width: 15%; font-weight: bold">
                                            FOR M/s:
                                        </td>
                                        <td style="text-decoration: underline; width: 35%;">
                                            <t t-esc="o.for_m_sc"/>
                                        </td>
                                        <td style="text-align: right; width: 10%; font-weight: bold">
                                            PO #:
                                        </td>
                                        <td style="text-decoration: underline; width: 15%;">
                                            <t t-esc="o.po_number_c"/>
                                        </td>
                                        <td style="text-align: right; width: 10%; font-weight: bold">
                                            Dated:
                                        </td>
                                        <td style="text-decoration: underline; width: 15%;">
                                            <t t-esc="o.dated_trc"/>
                                        </td>
                                    </tr>
                                </table>
                            </t>

                            <!-- IF Add-->
                            <t t-if="o.address_trc">
                                <div style="padding-left: 5px; margin-bottom: 5px;">
                                    <span style="font-weight: bold">Add: </span>
                                    <span style="text-decoration: underline"><t t-esc="o.address_trc"/></span>
                                </div>
                            </t>

                            <table class="table table-borderless">
                                <tr>
                                    <td style="text-align: left; padding-bottom: 2px; width: 20%; font-weight: bold">
                                        PRODUCT NAME:
                                    </td>
                                    <td style="text-decoration: underline; width: 20%;">
                                        <t t-esc="o.product_id.name"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        Model / Make:
                                    </td>
                                    <td style="text-decoration: underline; width: 22%;">
                                        <t t-esc="o.model_make"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 13%; font-weight: bold">
                                        Cooler ID#:
                                    </td>
                                    <td style="text-decoration: underline; width: 10%;">
                                        <t t-esc="o.cooler_id"/>
                                    </td>
                                </tr>
                            </table>
                            <table class="table table-borderless" style="table-layout: fixed">
                                <tr>
                                    <td style="text-align: left; padding-bottom: 2px; width: 20%; font-weight: bold">
                                        Frame Material:
                                    </td>
                                    <td style="text-decoration: underline; width: 30%;">
                                        <t t-esc="o.frame_material"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        New Frame
                                    </td>
                                    <td style="text-align: center; border: 1px solid black; width: 5%;">
                                        <t t-if="o.frame == 'new_frame'">✔</t>
                                        <t t-if="o.frame != 'new_frame'">✘</t>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        OLD Frame:
                                    </td>
                                    <td style="text-align: centre; border: 1px solid black; padding-bottom: 0px; width: 5%;">
                                        <t t-if="o.frame == 'old_frame'">✔</t>
                                        <t t-if="o.frame != 'old_frame'">✘</t>
                                    </td>
                                    <td style="width: 10%">
                                    </td>
                                </tr>
                            </table>

                            <!-- IF End Plate / Tube sheet Material-->
                            <t t-if="o.tube_sheet_material">
                                <div style="padding-left: 5px; margin-bottom: 5px;">
                                    <span style="font-weight: bold">End Plate / Tube sheet Material: </span>
                                    <span style="text-decoration: underline"><t t-esc="o.tube_sheet_material"/></span>
                                </div>
                            </t>


                            <table class="table table-borderless" style="table-layout: fixed">
                                <tr>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        Stack Size:
                                    </td>
                                    <td style="text-decoration: underline; width: 25%;">
                                        <t t-esc="o.stack_size"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        No. of Stacks:
                                    </td>
                                    <td style="text-decoration: underline; width: 15%;">
                                        <t t-esc="o.no_of_stacks"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        Refurbished:
                                    </td>
                                    <td style="text-decoration: underline; width: 15%;">
                                        <t t-esc="o.refurbished"/>
                                    </td>
                                </tr>
                            </table>

                            <table class="table table-borderless" style="table-layout: fixed">
                                <tr>
                                    <td style="text-align: left; padding-bottom: 2px; width: 20%; font-weight: bold">
                                        TUBE Material:
                                    </td>
                                    <td style="text-decoration: underline; width: 20%;">
                                        <t t-esc="o.tube_material"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 12%; font-weight: bold">
                                        Tube Size:
                                    </td>
                                    <td style="text-decoration: underline; width: 28%;">
                                        <t t-esc="o.tube_size"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        NO TUBES:
                                    </td>
                                    <td style="text-align: left; border: 1px solid black; padding-bottom: 0px; width: 5%; font-weight: bold">
                                        <t t-if="o.no_tubes">✔</t>
                                        <t t-if="not o.no_tubes">✘</t>
                                    </td>
                                </tr>
                            </table>

                            <table class="table table-borderless" style="table-layout: fixed">
                                <tr>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        No of Rows:
                                    </td>
                                    <td style="text-decoration: underline; width: 10%;">
                                        <t t-esc="o.no_of_rows"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 25%; font-weight: bold">
                                        No. of Tubes Each Row
                                    </td>
                                    <td style="text-decoration: underline; width: 15%;">
                                        <t t-esc="o.no_of_tubes_each_row"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 20%; font-weight: bold">
                                        Total No. of Tubes:
                                    </td>
                                    <td style="text-align: left; text-decoration: underline; padding-bottom: 0px; width: 15%;">
                                        <t t-esc="o.total_no_of_tubes"/>
                                    </td>
                                </tr>
                            </table>

                            <table class="table table-borderless" style="table-layout: fixed">
                                <tr>
                                    <td style="text-align: left; padding-bottom: 2px; width: 20%; font-weight: bold">
                                        Length of Tube:
                                    </td>
                                    <td style="text-decoration: underline; width: 10%;">
                                        <t t-esc="o.length_of_tube"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 30%; font-weight: bold">
                                        Total weight of copper tubes:
                                    </td>
                                    <td style="text-decoration: underline; width: 10%;">
                                        <t t-esc="o.total_weight_tubes"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        Make/Origin:
                                    </td>
                                    <td style="text-align: left; text-decoration: underline; padding-bottom: 0px; width: 15%;">
                                        <t t-esc="o.make_origin"/>
                                    </td>
                                </tr>
                            </table>

                            <div class="row"
                                 style="display: flex; width: 100%; justify-content: space-between; align-items: flex-start;">
                                <!-- Left Table -->
                                <table class="table table-borderless"
                                       style="width: 68%; margin-right: 2%; border-collapse: collapse;">
                                    <tr>
                                        <td style="text-align: left; padding-bottom: 2px; width: 20%; font-weight: bold">
                                            COPPER FINS:
                                        </td>

                                        <td style="text-align: center; border: 1px solid black; width: 5%; font-weight: bold">
                                            <t t-if="o.fins_type == 'copper_fins'">✔</t>
                                            <t t-if="o.fins_type != 'copper_fins'">✘</t>
                                        </td>
                                        <td style="text-align: left; padding-bottom: 2px; width: 20%; font-weight: bold">
                                            ALUMINIUM FINS:
                                        </td>
                                        <td style="text-align: left; border: 1px solid black; padding-bottom: 0px; width: 5%; font-weight: bold">
                                            <t t-if="o.fins_type == 'aluminum_fins'">✔</t>
                                            <t t-if="o.fins_type != 'aluminum_fins'">✘</t>
                                        </td>

                                        <td style="text-align: left; padding-bottom: 2px; width: 10%; font-weight: bold">
                                            NO FIN:
                                        </td>
                                        <td style="text-align: left; border: 1px solid black; padding-bottom: 0px; width: 5%; font-weight: bold">
                                            <t t-if="o.fins_type == 'no_fin'">✔</t>
                                            <t t-if="o.fins_type != 'no_fin'">✘</t>
                                        </td>
                                        <td style="text-align: right; padding-bottom: 2px; width: 15%; font-weight: bold">
                                            FIN COATING
                                        </td>
                                    </tr>
                                </table>

                                <table class="table"
                                       style="width: 28%; margin-left: 2%; border: 1px solid black; border-collapse: collapse; text-align: center; font-weight: bold">
                                    <tr>
                                        <td>
                                            NICKLE
                                        </td>
                                        <td>
                                            TIN
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <t t-if="o.fin_coating == 'nickle'">✔</t>
                                            <t t-if="o.fin_coating != 'nickle'">✘</t>
                                        </td>
                                        <td>
                                            <t t-if="o.fin_coating == 'tin'">✔</t>
                                            <t t-if="o.fin_coating != 'tin'">✘</t>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <!-- IF Add-->
                            <t t-if="o.fin_detail">
                                <div style="margin-top: -20px; padding-left: 5px; line-height: 1.5; padding-bottom: 0; margin-bottom: 0;">
                                    <div style="float: left; width: 12%; font-weight: bold;">
                                        Fin Detail:
                                    </div>
                                    <div style="float: left; text-decoration: underline; width: 88%;">
                                        <span t-field="o.fin_detail"/>
                                    </div>
                                </div>

                            </t>

                            <table class="table table-borderless" style="table-layout: fixed">
                                <tr>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        Total No. Fin:
                                    </td>
                                    <td style="text-decoration: underline; width: 15%;">
                                        <t t-esc="o.total_no_fin"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        Fins/inch:
                                    </td>
                                    <td style="text-decoration: underline; width: 30%;">
                                        <t t-esc="o.fins_inch"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 10%; font-weight: bold">
                                        Weight:
                                    </td>
                                    <td style="text-align: left; text-decoration: underline; padding-bottom: 0px; width: 15%;">
                                        <t t-esc="o.fin_weight"/>
                                    </td>
                                </tr>
                            </table>

                            <table class="table table-borderless" style="table-layout: fixed">
                                <tr>
                                    <td style="text-align: left; padding-bottom: 2px; width: 15%; font-weight: bold">
                                        Tube Expand by:
                                    </td>
                                    <td style="text-decoration: underline; width: 25%;">
                                        <t t-esc="o.tube_expand_by"/>
                                    </td>
                                    <td style="text-align: left; padding-bottom: 2px; width: 20%; font-weight: bold">
                                        Pressure Test at:
                                    </td>
                                    <td style="text-decoration: underline; width: 25%;">
                                        <t t-esc="o.pressure_test_at"/>
                                    </td>
                                </tr>
                            </table>

                            <div class="row"
                                 style="display: flex; width: 100%; justify-content: space-between; align-items: flex-start;">

                                <table class="table table-borderless"
                                       style="width: 48%; margin-right: 2%; border-collapse: collapse; table-layout: fixed">
                                    <tr>
                                        <td style="text-align: center; padding-bottom: 5px; width: 20%; font-weight: bold">
                                            For:
                                        </td>
                                        <td style="width: 50%; text-align: left;text-decoration: underline;">
                                            <span t-field="o.about_hours_for"/>
                                        </td>
                                        <td style="width: 30%; font-weight: bold">
                                            Pressure Test:
                                        </td>
                                    </tr>
                                </table>

                                <table class="table"
                                       style="width: 48%; margin-left: 2%; border: 1px solid black; border-collapse: collapse; text-align: center; font-weight: bold">
                                    <tr>
                                        <td style="border: 1px solid black;">Hydraulically</td>
                                        <td style="border: 1px solid black;">Air</td>
                                        <td style="border: 1px solid black;">Nitrogen</td>
                                    </tr>
                                    <tr>
                                        <td style="border: 1px solid black;">
                                            <t t-if="o.pressure_test == 'hydraulically'">✔</t>
                                            <t t-if="o.pressure_test != 'hydraulically'">✘</t>
                                        </td>
                                        <td style="border: 1px solid black;">
                                            <t t-if="o.pressure_test == 'air'">✔</t>
                                            <t t-if="o.pressure_test != 'air'">✘</t>
                                        </td>
                                        <td style="border: 1px solid black;">
                                            <t t-if="o.pressure_test == 'nitrogen'">✔</t>
                                            <t t-if="o.pressure_test != 'nitrogen'">✘</t>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <table class="table"
                                   style="border: 1px solid black; border-collapse: collapse; width: 100%">
                                <tr>
                                    <td style="border: 1px solid black; text-align: center; font-weight: bold; font-weight: bold">
                                        INSPECTION
                                    </td>
                                    <td style="border: 1px solid black; text-align: center; font-weight: bold; font-weight: bold">
                                        OMERDRAZ
                                        ENG. CO.
                                    </td>
                                    <td style="border: 1px solid black; text-align: center; font-weight: bold; font-weight: bold">
                                        THIRD
                                        PARTY INSPECTION
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; text-align: center; font-weight: bold">Name:
                                    </td>
                                    <td style="border: 1px solid black; text-align: center;">
                                        <t t-if="o.name_trc">
                                            <t t-esc="o.name_trc"/>
                                        </t>
                                        <t t-if="not o.name_trc">✘</t>
                                    </td>
                                    <td style="border: 1px solid black; text-align: center;">
                                        <t t-if="o.name_trc">
                                            <t t-esc="o.name_tp_trc"/>
                                        </t>
                                        <t t-if="not o.name_tp_trc">✘</t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; text-align: center; font-weight: bold">Date:
                                    </td>
                                    <td style="border: 1px solid black; text-align: center;">
                                        <t t-if="o.name_trc">
                                            <t t-esc="o.date_inspection_trc"/>
                                        </t>
                                        <t t-if="not o.date_inspection_trc">✘</t>
                                    </td>
                                    <td style="border: 1px solid black; text-align: center">
                                        <t t-if="o.name_trc">
                                            <t t-esc="o.date_inspection_rp_trc"/>
                                        </t>
                                        <t t-if="not o.date_inspection_rp_trc">✘</t>
                                    </td>
                                </tr>
                                <tr style="height: 50px;">
                                    <td style="border: none; vertical-align: middle; text-align: center; font-weight: bold">
                                        Signature:
                                    </td>
                                    <td style="border: 1px solid black; text-align: center;">
                                        <t t-esc="o.signature_trc"/>
                                    </td>
                                    <td style="border: 1px solid black; text-align: center;">
                                        <t t-esc="o.signature_tp_trc"/>
                                    </td>
                                </tr>
                            </table>
                        </t>
                    </div>

                    <div class="footer"
                         style="text-align: center; padding-top: 0px; border-top: 3px solid #f21d21; color: #c00000; font-weight: bold; margin-left: 80px; margin-right: 80px">
                        <table class="table table-borderless">
                            Add: 100-S QUAID-E-AZAM INDUSTRIAL ESTATE TOWNSHIP, LAHORE.
                            <br/>
                            Web:
                            <span style="color: #f7b615">www.omerdraz.com.pk/</span>
                            | E-mail: <span style="color: #f7b615">omerdraz786@hotmail.com</span>| Tel #: 042 – 35119080
                        </table>
                    </div>

                </t>
            </t>
        </template>
    </data>
</odoo>


