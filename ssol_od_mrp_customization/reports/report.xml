<odoo>
    <data>

        <record id="paperformat_od_quot_report_01" model="report.paperformat">
            <field name="name">European A4 Landscape</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_test_report_ms_coil" model="ir.actions.report">
            <field name="name">Test Report MS Coil</field>
            <field name="model">mrp.production</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ssol_od_mrp_customization.mrp_report_template_1</field>
            <field name="report_file">ssol_od_mrp_customization.mrp_report_template_1</field>
            <field name="paperformat_id" ref="paperformat_od_quot_report_01"/>
            <field name="binding_model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">('%s' % (object.name))</field>
        </record>
        <record id="action_test_report_ms_cooler" model="ir.actions.report">
            <field name="name">Test Report Cooler Heat</field>
            <field name="model">mrp.production</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ssol_od_mrp_customization.mrp_report_template_2</field>
            <field name="report_file">ssol_od_mrp_customization.mrp_report_template_2</field>
            <field name="paperformat_id" ref="paperformat_od_quot_report_01"/>
            <field name="binding_model_id" ref="mrp.model_mrp_production"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">('%s' % (object.name))</field>
        </record>

    </data>
</odoo>