<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_amount_in_words" model="ir.ui.view">
        <field name="name">account.invoice.form.amount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">


            <xpath expr="//field[@name='invoice_vendor_bill_id']" position="after">
                <field name="territory_id"/>
                <field name="vendor_code"/>
                <field name="gst_jurisdiction"/>
                <field name="hs_code"/>
            </xpath>


            <xpath expr="//field[@name='delivery_date']" position="after">
                <field name="po_number"/>
                <field name="dc_number"/>
            </xpath>

            <xpath expr="//group[@id='other_tab_group']" position="inside">
                <group name="bank_details" string="Bank Details">
                    <field name="account_title"/>
                    <field name="bank_name"/>
                    <field name="account_number"/>
                </group>
            </xpath>

            <!--            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='tax_ids']" position="after">-->
            <!--                <field name="tax_id"-->
            <!--                       widget="many2many_tags"/>-->
            <!--            </xpath>-->

        </field>
    </record>
</odoo>


