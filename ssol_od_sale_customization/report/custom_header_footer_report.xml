<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--CUSTOM HEADER FOOTER FOR Extreme fiber -->
        <template id="copper_quote_header_footer">
            <style>
                @font-face {
                font-family: 'Roman';
                src: url('/ssol_od_sale_customization/static/src/fonts/times-new-roman.ttf')
                format('truetype');
                }
                header {
                font-family: 'Roman', serif;
                }
                .font-text {
                font-family: 'Roman', sans-serif;
                }
            </style>
            <div class="header" style="font-size:17px; width: 100%; padding: 0; margin: 0; font-family: 'Roman', sans-serif;">
                <div class="row" style="margin-left: -25px; margin-right: -25px; margin-top: -10px">
                    <table class="table table-borderless" style="width: 100%; padding: 0; margin: 0;">
                        <tr>
                            <td style="padding-bottom: 0; margin-bottom: 0;">
                                <img src="ssol_od_sale_customization/static/src/img/header_footer/header.jpeg"
                                     width="100%"
                                     height="160px"
                                     style="margin-left: 0px, margin-right: 0px"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-top: 0; margin-top: 0;">
                                <center>
                                    <b>
                                        <u>
                                            <span style="font-size:20px"><strong>QUOTATION</strong></span>
                                        </u>
                                    </b>
                                </center>
                            </td>
                        </tr>
                    </table>
                </div>
                <div style="width:100%;margin-top:0px;margin-left:0px;margin-right:10px">
                    <div style="width:100%; margin-left:30px;">
                        <div style="width: 70%; float:left;">
                            <span>Ref:
                                <span style="margin-left:14px" t-field="docs.od_ref"/>
                            </span>
                            <br/>
                        </div>
                        <div style="width: 30%; padding-left: 70px; float: right; font-weight: bold">
                            <span>Date:
                                <span t-field="docs.date_order" t-options='{"format": "dd - MM - yyyy"}'/>
                            </span>
                        </div>
                    </div>
                    <div style="width:100%; margin-left:30px;">
                        <span><b>Attn:</b></span>
                        <b><span style="padding-left: 9px;" t-field="docs.partner_id.name"/></b>
                        <br/>
                        <i><span style="font-weight: normal; padding-left: 47px;" t-field="docs.partner_id.title.name"/></i>
                        <br/><br/>

                        <span><b>M/s:</b></span>
                        <t t-if="docs.partner_id.company_name">
                            <b><span style="padding-left: 13px;" t-field="docs.partner_id.company_name"/></b>
                        </t>
                        <t t-if="docs.partner_id.parent_id.name">
                            <b><span style="padding-left: 13px;" t-field="docs.partner_id.parent_id.name"/></b>
                        </t>

                        <table class="table table-borderless table-sm" style="color: black; margin: 0; border-spacing: 0;">
                            <tr style="margin: 0; padding: 0;">
                                <td style="width: 5%; white-space: nowrap; vertical-align: top; padding: 2px;">
                                    <b>
                                        <span>Add:</span>
                                    </b>
                                </td>
                                <td style="width: 20%; white-space: nowrap; vertical-align: top; padding: 2px;">
                                    <t t-if="docs.partner_id.contact_address">
                                        <span t-field="docs.partner_id.street"/>
                                        <span t-field="docs.partner_id.street2"/>
                                        <br/>
                                        <span t-field="docs.partner_id.city"/>
                                        <span t-field="docs.partner_id.state_id.name"/>
                                        <span t-field="docs.partner_id.zip"/>, <span t-field="docs.partner_id.country_id.name"/>
                                    </t>
                                </td>
                                <td style="width: 75%; vertical-align: top; padding: 2px;"/>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <!--Footer -->
            <div style="width:100%;" class="footer footer o_standard_footer">
                <div class="row" style="margin-left: -25px; margin-right: -25px; margin-top: -10px">
                    <table class="table table-borderless" style="width: 100%;">
                        <tr>
                            <td>
                                <img src="ssol_od_sale_customization/static/src/img/header_footer/footer.jpeg"
                                     width="100%"
                                     height="80px"
                                     style=""/>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </template>


