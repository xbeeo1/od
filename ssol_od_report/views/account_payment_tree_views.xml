<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_payment_tree_inherit_wh_tax_percentage" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.wh.tax.percentage</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="ssol_od_account_customization.od_view_account_payment_tree_wh_tax"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wh_tax_amount']" position="before">
                <field name="wh_tax_percentage"/>
            </xpath>
        </field>
    </record>
</odoo>