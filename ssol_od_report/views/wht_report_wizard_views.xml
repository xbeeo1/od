<odoo>
    <record id="view_wht_report_wizard_form" model="ir.ui.view">
        <field name="name">wht.report.wizard.form</field>
        <field name="model">wht.report.wizard</field>
        <field name="arch" type="xml">
            <form string="WHT Report">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="partner_id"/>
                </group>
                <footer>
                    <button name="action_generate_xlsx"
                            string="Generate"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wht_report_wizard" model="ir.actions.act_window">
        <field name="name">WHT Report</field>
        <field name="res_model">wht.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_wht_report"
              name="WHT Report"
              parent="accounting_pdf_reports.menu_finance_partner_reports"
              action="action_wht_report_wizard"
              sequence="5"/>
</odoo>