<odoo>
    <data>

        <record id="product_product_stock_tree" model="ir.ui.view">
            <field name="name">product.product.normal.tree.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="stock.product_product_stock_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='uom_id']" position="after">
                    <field name="converted_value"/>
                    <field name="conversion_uom_id"/>
                </xpath>

            </field>
        </record>


    </data>
</odoo>