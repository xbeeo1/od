<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="report_asset_details_wizard">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="oe_structure">
                        <div class="text-center">
                            <h1>Asset Details</h1>
                        </div>
                        <table style="border: 0px solid white">
                            <tr>
                                <td>Date From</td>
                                <td>:</td>
                                <td>
                                    <t t-esc="form['date_from']"/>
                                </td>
                            </tr>
                            <br/>
                            <tr>
                                <td>Date To</td>
                                <td>:</td>
                                <td>
                                    <t t-esc="form['date_to']"/>
                                </td>
                            </tr>
                        </table>
                        <br/>
                        <table class="table table-bordered mt32">
                            <thead>
                                <th name="th-name" class="text-left">
                                    <span>Asset Name</span>
                                </th>
                                <th name="th-id" class="text-left">
                                    <span>Employee ID</span>
                                </th>
                                <th name="th-provider" class="text-left">
                                    <span>Provided By</span>
                                </th>
                                 <th name="th-date" class="text-left">
                                    <span>Allotment Date</span>
                                </th>
                            </thead>
                            <!--                            <t t-set="appointment_count" t-value="0"/>-->
                            <t t-foreach="assets" t-as="line">
                                <!--                                <t t-set="appointment_count" t-value="appointment_count + 1"/>-->
                                <tr>
                                    <td>
                                        <span t-esc="line['name']"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['employee_asset_type_id'][1]"/>
                                    </td>
                                    <td>
                                        <span t-esc="line['provided_by'][1]"/>
                                    </td>
                                     <td>
                                        <span t-esc="line['asset_allotment_date']"/>
                                    </td>
                                </tr>
                            </t>
                            <!--                <td colspan="2">Total Appointments</td>-->
                            <!--                <td>-->
                            <!--                    <t t-esc="appointment_count"/>-->
                            <!--                </td>-->
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>