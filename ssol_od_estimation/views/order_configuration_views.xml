<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_estimation_form" model="ir.ui.view">
        <field name="name">Order.Estimation.Form</field>
        <field name="model">order.estimation</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="employee_asset_type_action" model="ir.actions.act_window">
        <field name="name">Employee Asset Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.asset.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create New Asset!
            </p>
        </field>
    </record>

    <menuitem id="menu_employee_assets_configuration"
              name="Configuration"
              parent="ssol_employee_assets.employee_assets_root"
              groups="ssol_employee_assets.group_employee_asset_manager"
              sequence="5"/>

    <menuitem id="employee_assets"
              name="Assets Type"
              parent="ssol_employee_assets.menu_employee_assets_configuration"
              action="employee_asset_type_action"
              sequence="1"/>

</odoo>