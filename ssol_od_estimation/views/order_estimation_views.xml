<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_estimation_form" model="ir.ui.view">
        <field name="name">order.estimation.form</field>
        <field name="model">order.estimation</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button id="button_draft" name="action_draft" type="object"
                            string="Set to draft" class="btn-primary" invisible="state not in ['confirmed', 'cancel']"/>
                    <button id="button_in_progress" name="action_in_progress" type="object"
                            string="In Progress" class="btn-primary" invisible="state not in ['draft']"/>
<!--                    <button id="button_compute_estimation" name="action_compute_estimation" type="object"-->
<!--                            string="Compute Estimation" class="btn-primary"/>-->
                    <button id="button_confirmed" name="action_confirmed" type="object" string="Confirmed"
                            class="btn-secondary" invisible="state not in ['in_progress']"/>
                    <button id="button_cancel" name="action_cancel" type="object" string="Cancel"
                            class="btn-secondary" invisible="state not in ['confirmed']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,confirmed"/>
                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">

                        <button name="create_manufacturing_order" type="object" class="oe_stat_button"
                                invisible="state not in ['confirmed'] or bom_id !=  False"
                                icon="fa-paper-plane">
                                Create MO
                        </button>
                        <button name="action_view_manufacturing_order" type="object" class="oe_stat_button"
                                invisible="not bom_id"
                                icon="fa-paper-plane">
                            View MO
                        </button>

                    </div>


                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" placeholder='Customer'/>
                            <field name="user_id" placeholder='Responsible'/>
                            <field name="total_amount" readonly="1"/>
                            <field name="sequence" invisible="1"/>
                            <field name="product_tmpl_id"/>
                            <field name="product_qty"/>
                        </group>
                        <group>
                            <field name="order_date" readonly="0" required="1"/>
                            <field name="attachment"/>
                            <field name="description" placeholder='Note'/>

                            <!--INVISIBLE FIELDS-->
                            <field name="company_id" invisible="1"/>
                            <field name="compute_lines_total" invisible="1"/>
                            <field name="is_mo" invisible="1"/>
                            <field name="bom_id" invisible="1" readonly="0"/>
                            <field name="mrp_order" invisible="1" readonly="0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Estimations" name="estimation_lines">
                                <field name="order_estimation_line" widget="section_and_note_one2many">
                                <tree string="Estimation Lines" editable="bottom">
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                    <field name="sr_no" column_invisible="True"/>
                                    <field name="sr_no_char" column_invisible="True"/>
                                    <field name="product_id"/>
                                    <field name="name" optional="hide"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom_category_id" column_invisible="True"/>
                                    <field name="product_uom_id" optional="hide"/>
                                    <field name="price_unit" column_invisible="False"/>
                                    <field name="price_subtotal" sum="Total"/>
                                    <field name="cost_price" optional="hide" sum="Total"/>
                                    <field name="profit_margin" optional="hide"  sum="Total"/>
                                    <field name="tax_id" widget="many2many_tags" optional="hide"/>
                                    <field name="amount_taxed" optional="hide" sum="Total"/>
                                    <field name="discount" optional="hide"/>
                                    <field name="disc_percentage" optional="hide"/>
                                    <field name="price_total" sum="Total"/>
                                </tree>
                            </field>

                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_order_estimation_tree" model="ir.ui.view">
        <field name="name">order.estimation.form</field>
        <field name="model">order.estimation</field>
        <field name="arch" type="xml">
            <tree multi_edit="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="user_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state  == 'draft'"/>
            </tree>
        </field>
    </record>

    <record id="view_order_estimation_calendar" model="ir.ui.view">
        <field name="name">order.estimation</field>
        <field name="model">order.estimation</field>
        <field name="arch" type="xml">
            <calendar string="Order Estimation" date_start="order_date" color="partner_id">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
            </calendar>
        </field>
    </record>

    <record id="view_order_estimation_search" model="ir.ui.view">
        <field name="name">order.estimation.search</field>
        <field name="model">order.estimation</field>
        <field name="arch" type="xml">
            <search string="Search Request">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="state"/>
                <filter string="Draft" name="state" domain="[('state', '=', 'draft')]"/>
                <filter string="Assigned" name="state" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Scrap" name="state" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Cancel" name="state" domain="[('state', '=', 'cancel')]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Unarchived" name="active" domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By" colspan="16">
                    <filter string="Customer" name="name" context="{'group_by':'partner_id'}"/>
                    <filter string="State" name="state" context="{'group_by':'state'}"/>
                    <filter string="Responsible" name="user_id" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_order_estimation" model="ir.actions.act_window">
        <field name="name">Order Estimation</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">order.estimation</field>
        <field name="view_mode">tree,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Order!
            </p>
        </field>
    </record>


    <menuitem id="menu_order_estimation"
              name="Orders"
              parent="ssol_od_estimation.menu_order_estimation_root"
              action="action_order_estimation"
              sequence="1"/>

</odoo>