<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record model="ir.module.category" id="module_category_order_estimation">
            <field name="name">Order Estimation</field>
            <field name="description">Assets : Employee Assets</field>
            <field name="sequence">2</field>
        </record>

        <record id="group_order_estimation_access" model="res.groups">
            <field name="name">1 - User</field>
            <field name="category_id" ref="ssol_od_estimation.module_category_order_estimation"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_employee_asset_manager" model="res.groups">
            <field name="name">2 - Manager</field>
            <field name="category_id" ref="ssol_od_estimation.module_category_order_estimation"/>
            <field name="implied_ids" eval="[(4, ref('ssol_od_estimation.group_order_estimation_access'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_order_estimation_delete_access" model="res.groups">
            <field name="name">3 - Order Estimation Delete Access</field>
            <field name="category_id" ref="ssol_od_estimation.module_category_order_estimation"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>